# Lokalt oppsett mot lokal Dialogporten — ingen remote nøkler.
# Se scripts/local-session.mjs for å opprette en sesjon uten ID-porten.

# --- Dialogporten (lokal) ---
# Port 7220 = GraphQL i Docker (docker-compose.yml i dialogporten-repoet).
# Kjører du GraphQL fra IDE i stedet, bruk 5181 (jf. Altinn/dialogporten
# docs/Local-run-arbeidsflate-and-dialogporten.md).
DIALOGPORTEN_URL=http://host.docker.internal:7220

# --- OIDC ---
# BFF henter .well-known ved oppstart (oidc.ts:165 og verifyToken.ts:107) og
# krasjer hvis den feiler. https:// legges på automatisk — verdien er uten skjema.
# Peker på en statisk discovery-JSON servert lokalt; endepunktene i den kalles
# aldri så lenge du bruker /api/init-session.
OIDC_PLATFORM_URL=oidc-static.localhost
OIDC_CLIENT_ID=local
OIDC_CLIENT_SECRET=local

# --- Altinn platform ---
# Ikke i bruk lokalt. Degraderer pent: tjenestenavn/logoer og profilfunksjoner
# faller bort, dialogene vises som normalt.
PLATFORM_BASEURL=http://localhost:9
ALTINN2_BASE_URL=http://localhost:9
ALTINN2_API_KEY=

# --- Sesjon ---
AUTH_CONTEXT_COOKIE_DOMAIN=localhost

# Lokal innlogging uten ID-porten: /api/login lager sesjonen direkte for denne
# personen. Settes av start.sh --pid. Tom verdi gir vanlig OIDC-flyt.
LOCAL_DEV_PID=__LOCAL_DEV_PID__

# --- Person-URN-kryptering ---
# MÅ være satt: tom verdi gir keys.length === 0 og kast ved import i
# party/personUrnCipher.ts:30, som crash-looper BFF-containeren.
# Hold den stabil mellom omstarter.
PERSON_URN_ENC_KEYS=__PERSON_URN_ENC_KEYS__

# --- Valgfritt / ubrukt lokalt ---
APP_CONFIG_CONNECTION_STRING=
MASKINPORTEN_CLIENT_ID=
MASKINPORTEN_JWK=
MASKINPORTEN_ISSUER=https://test.maskinporten.no/
MASKINPORTEN_SCOPE=
OCP_APIM_SUBSCRIPTION_KEY=
REGISTER_SUBSCRIPTION_KEY=
OTEL_NAMESPACE=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_RESOURCE_ATTRIBUTES=

# Playwright (mock-modus, uavhengig av alt over)
PLAYWRIGHT_TEST_BASE_URL=http://localhost:5173
